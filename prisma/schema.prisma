generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Reservation {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String
  memberType   String
  bookTitle    String
  pickupDate   DateTime
  durationDays Int
  notes        String?
  createdAt    DateTime @default(now())
}

model Book {
  id          String   @id @default(cuid())
  title       String   @unique
  author      String
  genre       String
  description String
  visualStyle String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ReaderStory {
  id          String   @id @default(cuid())
  quote       String
  author      String
  memberSince Int
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
